# MongoDB Atlas Connection String
# Get this from: Atlas Dashboard > Connect > Connect your application
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# Resend (transactional email)
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Domain used for outbound email "From" addresses and mailto links.
# Defaults to sorvenestudio.com when unset.
EMAIL_DOMAIN=sorvenestudio.com

# Admin login credentials. If either is unset, admin login is disabled.
ADMIN_USERNAME=change_me_admin_username
ADMIN_PASSWORD=change_me_admin_password

# Secret used to sign the admin session cookie. Use a long random string.
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=generate_a_long_random_secret_here

# Cloudflare R2 (S3-compatible object storage)
# Account ID: Cloudflare Dashboard -> R2 -> Overview
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Access Key ID / Secret: create an R2 API Token (with Object Read & Write)
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# Bucket used for product media
R2_BUCKET_NAME=your_r2_bucket_name_here

# Public base URL for the bucket (Public Development URL or custom domain)
R2_PUBLIC_URL=https://your-public-r2-url.example.com
