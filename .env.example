# MongoDB Atlas Connection String
# Get this from: Atlas Dashboard > Connect > Connect your application
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# Resend (transactional email)
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Domain used for outbound email "From" addresses and mailto links.
# Defaults to sorvenestudio.com when unset.
EMAIL_DOMAIN=sorvenestudio.com

# Admin login credentials. If either is unset, admin login is disabled.
ADMIN_USERNAME=change_me_admin_username
ADMIN_PASSWORD=change_me_admin_password

# Secret used to sign the admin session cookie. Use a long random string.
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=generate_a_long_random_secret_here

# Cloudflare R2 (S3-compatible object storage)
# Account ID: Cloudflare Dashboard -> R2 -> Overview
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Access Key ID / Secret: create an R2 API Token (with Object Read & Write)
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# Bucket used for product media
R2_BUCKET_NAME=your_r2_bucket_name_here

# Public base URL for the bucket (Public Development URL or custom domain)
R2_PUBLIC_URL=https://your-public-r2-url.example.com

# Firebase (client-side web config — safe to expose via NEXT_PUBLIC_).
# Get these from: Firebase Console > Project settings > General > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Firebase Admin SDK (verifies customer phone OTP tokens server-side).
# Download a service account key: Firebase Console > Project settings > Service accounts.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# Secret used to sign customer session cookies. Generate with: openssl rand -base64 32
CUSTOMER_SESSION_SECRET=generate_a_long_random_secret_here

# WhatsApp Cloud API (Meta). Server-only — never prefix with NEXT_PUBLIC_.
# Get these from: developers.facebook.com > your app > WhatsApp > API Setup.
# Access token (use a permanent system-user token in production; the temporary one expires in ~24h)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
# Sender phone number ID (the Meta test number's ID in development)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
# WhatsApp Business Account ID (reserved for template management; not used when sending)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
# App secret (App settings > Basic) — verifies X-Hub-Signature-256 on webhooks
WHATSAPP_APP_SECRET=your_meta_app_secret_here
# Any long random string you also enter in the webhook configuration — Meta echoes it during verification
WHATSAPP_VERIFY_TOKEN=generate_a_long_random_verify_token_here
# Graph API version, format vNN.N (e.g. v23.0). Anything else is rejected.
WHATSAPP_API_VERSION=v23.0

# Payments provider — selects the active payments integration. Defaults to
# razorpay. Add a new implementation under src/backend/integrations/payments/
# to support another gateway (e.g. stripe).
PAYMENT_PROVIDER=razorpay

# Razorpay (server-only). Get these from: Razorpay Dashboard > Settings > API Keys.
# The key id is also exposed to the client via the create-order response, so no
# NEXT_PUBLIC_ copy is required for checkout.
RAZORPAY_KEY_ID=your_razorpay_key_id_here
# Server-only — never prefix with NEXT_PUBLIC_.
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
